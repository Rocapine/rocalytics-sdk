{
  "name": "@rocapine/rocalytics-sdk",
  "version": "0.1.0",
  "description": "Headless client SDK for Onboarding Studio: a typed onboarding run tracker for any onboarding, including hand-coded ones, and the Rocalytics client",
  "keywords": [
    "onboarding",
    "analytics",
    "funnel",
    "react-native",
    "headless",
    "rocalytics"
  ],
  "author": "Rocapine",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rocapine/rocalytics-sdk.git"
  },
  "sideEffects": false,
  "exports": {
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "default": "./dist/onboarding/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "onboarding": [
        "./dist/onboarding/index.d.ts"
      ],
      "core": [
        "./dist/core/index.d.ts"
      ],
      "client": [
        "./dist/client/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "onboarding",
    "core",
    "client",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run lint && npm run type:check:tests && npm test && npm run check:exports",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "type:check:tests": "tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:schema-types": "UPDATE_SCHEMA_TYPES=1 vitest run test/schema-types.test.ts",
    "check:exports": "node scripts/check-exports.mjs"
  },
  "peerDependencies": {
    "expo-application": "*",
    "expo-crypto": "*",
    "expo-device": "*",
    "expo-modules-core": "*",
    "expo-network": "*",
    "expo-secure-store": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-application": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    },
    "expo-device": {
      "optional": true
    },
    "expo-modules-core": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.4",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  }
}
