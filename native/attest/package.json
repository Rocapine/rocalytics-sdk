{
  "name": "@rocapine/rocalytics-attest",
  "version": "0.1.0",
  "description": "App Attest (iOS) and Play Integrity (Android) for the Rocalytics SDK",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "ios",
    "android",
    "plugin",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "!plugin/*.test.js",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "build": "rm -rf build && tsc -p tsconfig.json",
    "test": "node --test plugin/withRocaAttest.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "app-attest",
    "play-integrity",
    "rocalytics"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rocapine/rocalytics-sdk.git",
    "directory": "native/attest"
  },
  "bugs": {
    "url": "https://github.com/Rocapine/rocalytics-sdk/issues"
  },
  "homepage": "https://github.com/Rocapine/rocalytics-sdk/tree/main/native/attest#readme",
  "author": "Rocapine",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*"
  },
  "devDependencies": {
    "expo-modules-core": "^58.1.0",
    "typescript": "^5.9.3"
  }
}
